        <mxCell id="ui" parent="1" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=18;fontFamily=Segoe UI;fontSize=16;fontColor=#203047;strokeWidth=1.5;fillColor=#f5eef9;strokeColor=#9370ac;" value="&lt;b&gt;&lt;font style=&quot;font-size:19px&quot;&gt;Host &amp;amp; Guest UI + Integrated Player&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;br&gt;Browser (HTML / CSS / JS + YT.Player)&lt;br&gt;User interactions, QR join &amp;amp; host playback&lt;br&gt;Browser state: userId cookie &amp;amp; localStorage name" vertex="1">
