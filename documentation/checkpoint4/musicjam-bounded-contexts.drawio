        <mxCell id="gateway" parent="1" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=16;fontFamily=Segoe UI;fontSize=15;fontColor=#203047;strokeWidth=2;fillColor=#ede9fe;strokeColor=#7c3aed;" value="&lt;b&gt;&lt;font style=&quot;font-size:19px&quot;&gt;API Gateway · musicjam-frontend (Nginx :8000 → :80)&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;br&gt;Serves static frontend · Proxies /api/* &amp;amp; /healthz → http://app:8000&lt;br&gt;Forwards Host &amp;amp; X-Forwarded-Host headers for LAN QR code URLs" vertex="1">
