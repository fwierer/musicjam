<mxfile host="app.diagrams.net">
  <diagram id="musicjam-domain" name="Domain concept map">
    <mxGraphModel dx="2814" dy="885" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="900" math="0" shadow="0">
