        <mxCell id="ctx_core" parent="1" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#FAFAF8;strokeColor=#B4B2A9;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontStyle=1;fontColor=#5F5E5A;" value="Jam session - core domain" vertex="1">
          <mxGeometry height="300" width="1010" x="-170" y="150" as="geometry" />
